# ForgeFuscator Discord Bot Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (Required)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# External Obfuscation API Configuration (Required)
API_BASE_URL=https://YOUR-OBFUSCATION-API.onrender.com
API_KEY=YOUR_OBFUSCATOR_API_KEY_HERE
API_TIMEOUT=30000

# Bot Configuration (Optional)
BOT_PREFIX=ff!
BOT_VERSION=1.0.0

# Credits System (Optional)
OPERATION_COST=1

# Rate Limiting (Optional)
COMMAND_COOLDOWN=5000

# File Limits (Optional)
MAX_FILE_SIZE=1048576
